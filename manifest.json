{
  "manifest_version": 3,
  "name": "YouTube Material 3 Expressive",
  "short_name": "YT MD3",
  "version": "1.0.0",
  "description": "Редизайн YouTube в MD3: цвета RGB, иконки, 48 форм аватарок. Только для тёмной темы (в светлой чёрный текст). t.me/okdrmd3mods",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://i.ytimg.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Material 3 Expressive",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": [
        "src/md3-youtube.css"
      ],
      "js": [
        "src/md3-color.js",
        "src/md3-shapes.js",
        "src/md3-icons.js",
        "src/content.js"
      ]
    }
  ]
}
